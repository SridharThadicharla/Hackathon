    {
      "name": "01 - Carrier Webhook Ingestion",
      "item": [
        {
          "name": "POST BlueDart Webhook - In Transit Scan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has success true\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.carrier).to.eql(\"BLUEDART\");",
                  "    pm.expect(json.normalizedStatus).to.eql(\"IN_TRANSIT\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Carrier-Token",
                "value": "{{bluedartToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"awb_no\": \"{{trackingNumberBlueDart}}\",\n  \"status_code\": \"IT\",\n  \"status_description\": \"In Transit - Forwarded to Destination Hub\",\n  \"scan_date_time\": \"2026-10-11T10:30:00+05:30\",\n  \"location_code\": \"DEL/HUB\",\n  \"location_name\": \"Delhi Regional Sorting Hub\",\n  \"eta\": \"2026-10-14T18:00:00+05:30\"\n}"
