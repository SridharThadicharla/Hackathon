	<munit:config name="db-operations-munit" />

	<!-- ========================================================================= -->
	<!-- TEST 1: subflow-select-event-by-key                                       -->
	<!-- ========================================================================= -->
	<munit:test name="test-db-select-event-by-key" description="Test subflow-select-event-by-key queries tracking event by unique key">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select" doc:name="Mock Query Existing Event">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="db-get-by-key" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="existingEvent" value="#[[{ id: 101, event_key: 'KEY-TEST-01' }]]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="canonicalEvent" value="#[{ eventKey: 'KEY-TEST-01' }]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="subflow-select-event-by-key" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert existingEvent found"
				actual="#[sizeOf(vars.existingEvent)]" expected="#[1]" />
			<munit-tools:assert-equals doc:name="Assert Event ID"
				actual="#[vars.existingEvent[0].id]" expected="#[101]" />
		</munit:validation>
	</munit:test>

	<!-- ========================================================================= -->
	<!-- TEST 2: subflow-select-shipment-by-tracking-number                         -->
	<!-- ========================================================================= -->
	<munit:test name="test-db-select-shipment-by-tracking-number" description="Test subflow-select-shipment-by-tracking-number queries master shipment">
		<munit:behavior>
			<munit-tools:mock-when processor="db:select" doc:name="Mock Query Shipment by Tracking">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="db-get-by-tracking" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="shipmentRecord" value="#[[{ shipment_id: 'SHP-1001', tracking_number: 'BD-TRK-01' }]]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="canonicalEvent" value="#[{ trackingNumber: 'BD-TRK-01' }]" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="subflow-select-shipment-by-tracking-number" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert shipmentRecord found"
				actual="#[sizeOf(vars.shipmentRecord)]" expected="#[1]" />
			<munit-tools:assert-equals doc:name="Assert Shipment ID"
				actual="#[vars.shipmentRecord[0].shipment_id]" expected="#['SHP-1001']" />
		</munit:validation>
	</munit:test>

	<!-- ========================================================================= -->
	<!-- TEST 3: subflow-insert-tracking-event                                     -->
	<!-- ========================================================================= -->
	<munit:test name="test-db-insert-tracking-event-success" description="Test subflow-insert-tracking-event persists audit event successfully">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert" doc:name="Mock Insert Tracking Event">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="db-insert-event" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ affectedRows: 1 }]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="canonicalEvent" value="#[{
						eventKey: 'BLUEDART-BD-101-IT-20261010110000',
						eventId: 'EVT-101',
						shipmentId: 'SHP-1001',
						trackingNumber: 'BD-101',
						carrier: 'BLUEDART',
						originalStatus: 'IT',
						normalizedStatus: 'IN_TRANSIT',
						eventTimestamp: '2026-10-10T11:00:00Z',
						receivedTimestamp: '2026-10-10T11:05:00Z',
						location: 'Mumbai Hub',
						description: 'In Transit',
						sourcePayload: '{}'
					}]" />
					<munit:variable key="processingResult" value="#['PROCESSED']" />
					<munit:variable key="correlationId" value="#['corr-db-insert-01']" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="subflow-insert-tracking-event" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert Affected Rows"
				actual="#[payload.affectedRows]" expected="#[1]" />
		</munit:validation>
	</munit:test>

