		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert HTTP Status 503"
				actual="#[vars.httpStatus]" expected="#['503']" />
			<munit-tools:assert-equals doc:name="Assert Error Code DATABASE_UNAVAILABLE"
				actual="#[payload.error.code]" expected="#['DATABASE_UNAVAILABLE']" />
		</munit:validation>
	</munit:test>

	<!-- Test 9: ANY / Internal Server Error (HTTP 500) -->
	<munit:test name="test-error-handling-any-internal-error" description="Verify ANY unhandled error formats 500 error response">
		<munit:execution>
			<munit:set-event>
				<munit:variables>
					<munit:variable key="correlationId" value="#['corr-err-500']" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="test-harness-any-error" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert HTTP Status 500"
				actual="#[vars.httpStatus]" expected="#['500']" />
			<munit-tools:assert-equals doc:name="Assert Error Code INTERNAL_SERVER_ERROR"
				actual="#[payload.error.code]" expected="#['INTERNAL_SERVER_ERROR']" />
		</munit:validation>
	</munit:test>

</mule>
