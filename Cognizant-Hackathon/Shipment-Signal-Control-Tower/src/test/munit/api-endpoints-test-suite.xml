	<!-- ========================================================================= -->
	<!-- TEST: POST /webhooks/carriers/{carrierCode} (Generic Carrier Ingestion)    -->
	<!-- ========================================================================= -->
	<munit:test name="test-api-webhook-carriers-bluedart-success" description="Test POST /webhooks/carriers/{carrierCode} routes and authenticates BlueDart">
		<munit:behavior>
			<munit-tools:mock-when processor="flow-ref" doc:name="Mock Flow Process Canonical Event">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="flow-process-canonical-event" attributeName="name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value='#[{
						"success": true,
						"status": "EVENT_PROCESSED_SUCCESSFULLY",
						"trackingNumber": "BD-987654321",
						"carrier": "BLUEDART"
					}]' mediaType="application/java" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value='#[{
					"awb_no": "BD-987654321",
					"status_code": "IT",
					"status_description": "In Transit",
					"scan_date_time": "2026-10-10T11:00:00+05:30"
				}]' mediaType="application/java" />
				<munit:attributes value="#[{
					uriParams: { 'carrierCode': 'BLUEDART' },
					headers: { 'x-carrier-token': 'bluedart-webhook-secret-key-2026' }
				}]" />
				<munit:variables>
					<munit:variable key="correlationId" value="#['corr-api-wh-01']" />
				</munit:variables>
			</munit:set-event>
			<flow-ref name="post:\webhooks\carriers\(carrierCode):application\json:shipment-tracking-config" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert Carrier Variable is BLUEDART"
				actual="#[vars.carrier]" expected="#['BLUEDART']" />
			<munit-tools:assert-equals doc:name="Assert Success Response Status"
				actual="#[payload.status]" expected="#['EVENT_PROCESSED_SUCCESSFULLY']" />
		</munit:validation>
	</munit:test>

