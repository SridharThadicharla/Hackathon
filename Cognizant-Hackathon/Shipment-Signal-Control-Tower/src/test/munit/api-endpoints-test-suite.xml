	<!-- TEST: POST /shipments (Create / Seed Master Shipment Record)               -->
	<!-- ========================================================================= -->
	<munit:test name="test-api-post-shipment-success" description="Test POST /shipments registers master record and returns HTTP 201">
		<munit:behavior>
			<munit-tools:mock-when processor="db:insert" doc:name="Mock Insert Shipment Record">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="Insert New Shipment" attributeName="doc:name" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload value="#[{ affectedRows: 1 }]" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit-tools:mock-when processor="db:select" doc:name="Mock Query Created Shipment">
				<munit-tools:with-attributes>
					<munit-tools:with-attribute whereValue="db-get-by-id" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:variables>
						<munit-tools:variable key="queriedShipment" value="#[[{
							shipment_id: 'SHP-1001',
							tracking_number: 'BD-987654321',
							carrier: 'BLUEDART',
							origin_location: 'Mumbai Hub',
							destination_location: 'Delhi Hub',
							current_status: 'LABEL_CREATED',
							status_rank: 10,
							last_event_timestamp: null,
							estimated_delivery_time: null,
							promised_delivery_time: '2026-10-15 18:00:00',
							risk_level: 'ON_TRACK',
							risk_reason: 'Shipment manifested.',
							created_at: '2026-10-10 09:00:00',
							updated_at: '2026-10-10 09:00:00'
						}]]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<munit:set-event>
				<munit:payload value='#[{
					"shipmentId": "SHP-1001",
					"trackingNumber": "BD-987654321",
					"carrier": "BLUEDART",
					"originLocation": "Mumbai Hub",
					"destinationLocation": "Delhi Hub",
					"promisedDeliveryTime": "2026-10-15T18:00:00Z"
				}]' mediaType="application/java" />
			</munit:set-event>
			<flow-ref name="post:\shipments:application\json:shipment-tracking-config" />
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-equals doc:name="Assert HTTP Status 201"
				actual="#[vars.httpStatus]" expected="#['201']" />
			<munit-tools:assert-equals doc:name="Assert Created Shipment ID"
				actual="#[payload.shipmentId]" expected="#['SHP-1001']" />
			<munit-tools:assert-equals doc:name="Assert Tracking Number"
				actual="#[payload.trackingNumber]" expected="#['BD-987654321']" />
			<munit-tools:assert-equals doc:name="Assert Current Status"
				actual="#[payload.currentStatus]" expected="#['LABEL_CREATED']" />
		</munit:validation>
	</munit:test>

